# Copy this file to .env and fill it in. .env is gitignored and never leaves your machine.
# The browser never sees these values; only server.js reads them.

# Your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: a secret of your choosing. Open the game once as http://localhost:8643/?owner=<secret>
# to skip the guest token budget in that browser.
MR_OWNER_TOKEN=

# Optional: tokens each guest session may spend before the game falls back to offline mode.
MR_GUEST_BUDGET=300000
